# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pratha_restaurant

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin (used by seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pratha.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Where to send notifications for new contact-form submissions
# (falls back to the site's contact email in Settings, then ADMIN_EMAIL)
CONTACT_ADMIN_EMAIL=admin@pratha.com


# Email (SMTP) - fill these to enable order confirmation emails
SMTP_HOST=your-mail-server-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email
SMTP_PASS=your-email-app-password
SMTP_FROM=Your-company-name

# Optional: HTTPS email API (recommended on Railway/Render - Gmail SMTP is often
# blocked from cloud hosts). If RESEND_API_KEY is set, emails go through Resend
# (api.resend.com) and SMTP is only a fallback. Get a key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Paratha Chai <no-reply@yourdomain.com>